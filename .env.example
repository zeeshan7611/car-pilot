PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/carpilot

# Redis (BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=super_secret_carpilot_jwt_key_change_in_prod
JWT_REFRESH_SECRET=super_secret_carpilot_refresh_jwt_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# AI Provider Configuration (Abstraction Layer)
# Providers: mock | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage (local or s3)
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=carpilot-media
